{
	"name": "elightup/twig",
	"type": "library",
	"config": {
		"prepend-autoloader": false
	},
	"autoload": {
		"psr-4": {
			"eLightUp\\": "./"
		},
		"files": [
			"src/deprecation-contracts.php",
			"Symfony/Polyfill/Ctype/bootstrap.php",
			"Symfony/Polyfill/Mbstring/bootstrap.php",
			"Symfony/Polyfill/Php80/bootstrap.php",
			"Symfony/Polyfill/Php81/bootstrap.php"
		]
	},
	"scripts": {
		"post-install-cmd": [
			"composer dump-autoload"
		],
		"post-update-cmd": [
			"composer dump-autoload"
		]
	},
	"extra": {
		"mozart": {
			"dep_namespace": "eLightUp\\",
			"dep_directory": "/",
			"classmap_directory": "/",
			"classmap_prefix": "eLightUp_",
			"packages": [
				"twig/twig"
			],
			"delete_vendor_directories": true
		}
	}
}
